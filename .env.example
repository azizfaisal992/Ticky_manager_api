# Local development uses SQLite automatically. Set this to PostgreSQL in production.
DATABASE_URL=sqlite:///./taskmanager.db

# Generate a production value with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-production-secret

# Comma-separated browser origins. Android apps do not require CORS entries.
ALLOWED_ORIGINS=*

